# ═══════════════════════════════════════════════════════════════
#  SwayFX — config basada en los keybinds de niri + noctalia
#  Read `man 5 sway` for a complete reference.
# ═══════════════════════════════════════════════════════════════


# ═══════════════════════════════════════════════════════════════
# 1. VARIABLES
# ═══════════════════════════════════════════════════════════════
set $mod   Mod4
set $term  foot


# ═══════════════════════════════════════════════════════════════
# 2. OUTPUTS
# ═══════════════════════════════════════════════════════════════
# Sin wallpaper declarado — noctalia lo gestiona.


# ═══════════════════════════════════════════════════════════════
# 3. INPUT
# ═══════════════════════════════════════════════════════════════
input type:touchpad {
    tap                enabled
    natural_scroll     enabled
    dwt                enabled
    middle_emulation   enabled
    drag_lock          disabled
}

input type:keyboard {
    xkb_layout us
    xkb_variant intl
}


# ═══════════════════════════════════════════════════════════════
# 4. APPEARANCE — gaps, bordes y efectos visuales
# ═══════════════════════════════════════════════════════════════
# Gaps y bordes (coinciden con niri)
default_border            pixel 2
default_floating_border   pixel 2
animation_duration_ms     250

gaps inner                8
gaps outer                0
smart_borders             off
smart_gaps                off

# Desenfoque (valores trasladados desde la config de Umbriel)
blur              enable
blur_xray         disable
blur_passes       4
blur_radius       6
blur_noise        0.02
blur_brightness   1.0
blur_contrast     1.0
blur_saturation   1.5

# Sombras
shadows              enable
shadow_blur_radius   20
# shadow_color        #00000022
# shadow_offset       0 0

# Transparencia de ventanas (para que el blur se vea)
for_window [class=".*"] opacity 0.91


# ═══════════════════════════════════════════════════════════════
# 5. KEYBINDINGS
# ═══════════════════════════════════════════════════════════════

# ── Noctalia ────────────────────────────────────────────────────
bindsym $mod+Shift+Escape    exec noctalia msg hotkey-overlay
bindsym $mod+Shift+Slash     exec noctalia msg hotkey-overlay

# ── Applications ────────────────────────────────────────────────
bindsym $mod+Return    exec $term
bindsym $mod+t         exec $term
bindsym $mod+e         exec thunar
bindsym $mod+b         exec helium
bindsym $mod+y         exec noctalia msg panel-toggle wallpaper
bindsym $mod+Space     exec noctalia msg panel-toggle launcher
bindsym $mod+x         exec noctalia msg panel-toggle session
bindsym $mod+Comma     exec noctalia msg settings-toggle
bindsym $mod+s         exec noctalia msg panel-toggle control-center
bindsym $mod+Shift+b   exec noctalia msg bar-toggle

# ── Media ───────────────────────────────────────────────────────
bindsym --locked XF86AudioRaiseVolume    exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume    exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute           exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute        exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

# ── Brightness ─────────────────────────────────────────────────
bindsym --locked XF86MonBrightnessUp      exec noctalia msg brightness-up
bindsym --locked XF86MonBrightnessDown    exec noctalia msg brightness-down

# ── Window: close / focus / move ───────────────────────────────
bindsym $mod+q            kill

bindsym $mod+Left         focus left
bindsym $mod+Right        focus right
bindsym $mod+Up           focus up
bindsym $mod+Down         focus down

bindsym $mod+Ctrl+Left    move left
bindsym $mod+Ctrl+Right   move right
bindsym $mod+Ctrl+Up      move up
bindsym $mod+Ctrl+Down    move down

# ── Monitors ───────────────────────────────────────────────────
bindsym $mod+Home                focus output left
bindsym $mod+End                 focus output right
bindsym $mod+Ctrl+Home           move container to output left
bindsym $mod+Ctrl+End            move container to output right

bindsym $mod+Shift+Left          focus output left
bindsym $mod+Shift+Right         focus output right
bindsym $mod+Shift+Up            focus output up
bindsym $mod+Shift+Down          focus output down

bindsym $mod+Shift+Ctrl+Left    move container to output left
bindsym $mod+Shift+Ctrl+Right   move container to output right
bindsym $mod+Shift+Ctrl+Up      move container to output up
bindsym $mod+Shift+Ctrl+Down    move container to output down

# ── Workspaces ─────────────────────────────────────────────────
bindsym $mod+u       workspace prev
bindsym $mod+i       workspace next
bindsym $mod+Tab     workspace back_and_forth

bindsym $mod+Ctrl+u  move container to workspace prev
bindsym $mod+Ctrl+i  move container to workspace next

bindsym $mod+1       workspace number 1
bindsym $mod+2       workspace number 2
bindsym $mod+3       workspace number 3
bindsym $mod+4       workspace number 4
bindsym $mod+5       workspace number 5
bindsym $mod+6       workspace number 6
bindsym $mod+7       workspace number 7
bindsym $mod+8       workspace number 8
bindsym $mod+9       workspace number 9

bindsym $mod+Ctrl+1  move container to workspace number 1
bindsym $mod+Ctrl+2  move container to workspace number 2
bindsym $mod+Ctrl+3  move container to workspace number 3
bindsym $mod+Ctrl+4  move container to workspace number 4
bindsym $mod+Ctrl+5  move container to workspace number 5
bindsym $mod+Ctrl+6  move container to workspace number 6
bindsym $mod+Ctrl+7  move container to workspace number 7
bindsym $mod+Ctrl+8  move container to workspace number 8
bindsym $mod+Ctrl+9  move container to workspace number 9

# ── Layout: splits (H = horizontal, V = vertical) ─────────────
bindsym $mod+h  splith
bindsym $mod+v  splitv

# ── Layout: estilos ───────────────────────────────────────────
bindsym $mod+w         layout toggle split tabbed
bindsym $mod+Ctrl+s    layout toggle split stacking

# ── Fullscreen / floating ─────────────────────────────────────
bindsym $mod+f            fullscreen
bindsym $mod+a            floating toggle
bindsym $mod+Shift+space  focus mode_toggle
floating_modifier $mod normal

# ── Center ────────────────────────────────────────────────────
bindsym $mod+c  move position center

# ── Resizing: teclas directas ─────────────────────────────────
bindsym $mod+minus        resize shrink width  10px
bindsym $mod+equal        resize grow   width  10px
bindsym $mod+Shift+minus  resize shrink height 10px
bindsym $mod+Shift+equal  resize grow   height 10px

# ── Resizing: modo (entrar con Mod+R) ────────────────────────
mode "resize" {
    bindsym Left    resize shrink width  10px
    bindsym Down    resize grow   height 10px
    bindsym Up      resize shrink height 10px
    bindsym Right   resize grow   width  10px

    bindsym Return  mode "default"
    bindsym Escape  mode "default"
}
bindsym $mod+r mode "resize"

# ── Screenshots ───────────────────────────────────────────────
# Print       → región interactiva (selección con slurp)
# Ctrl+Print  → pantalla completa
# Alt+Print   → ventana enfocada
# Guarda en ~/Pictures/Screenshots/ y copia al portapapeles
set $shot ~/.config/sway/scripts/screenshot.sh
bindsym Print        exec $shot region
bindsym Ctrl+Print   exec $shot screen
bindsym Alt+Print     exec $shot window

# ── Reload / Exit / Power ─────────────────────────────────────
bindsym $mod+Shift+c  reload
bindsym $mod+Shift+e  exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
bindsym $mod+Shift+p  exec swaymsg "output * power off"


# ═══════════════════════════════════════════════════════════════
# 6. AUTOSTART
# ═══════════════════════════════════════════════════════════════
exec    noctalia
# No usamos swaybar — noctalia trae su propia barra
exec_always --no-startup-id  sh -c 'pkill -f swaybar 2>/dev/null; true'
# Detener el swaybg auto-lanzado — noctalia gestiona el wallpaper
exec_always --no-startup-id  sh -c 'pkill -f swaybg 2>/dev/null; true'


# ═══════════════════════════════════════════════════════════════
# 7. INCLUDES
# ═══════════════════════════════════════════════════════════════
include /etc/sway/config.d/*
include ~/.config/sway/noctalia
