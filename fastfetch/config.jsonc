{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "Sixel",
    "source": " ",
    "width": 30,
    "height": 15,
    "padding": {
      "top": 0,
      "left": 0,
      "right": 4
    },
    "color": {
      "1": "#63c6ff",
      "2": "#63c6f9"
    }
  },
  "display": {
    "separator": ":  ",
    "color": {
      "keys": "#aec6ff",
      "title": "#b1c6f9"
    },
    "percent": {
      "color": {
        "green": "#f2afff",
        "yellow": "#aec6ff",
        "red": "#ffb4ab"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "key": "  ",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "separator",
      "string": "________________________________________"
    },
    {
      "type": "os",
      "key": "  󰣇 OS",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": "   Kernel",
      "keyColor": "cyan"
    },
    {
      "type": "uptime",
      "key": "  󱫐 Uptime",
      "keyColor": "cyan"
    },
    {
      "type": "packages",
      "key": "  󰏗 Packages",
      "keyColor": "cyan"
    },
    {
      "type": "wm",
      "key": "  󱗃 WM",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": "   Terminal",
      "keyColor": "cyan"
    },
    {
      "type": "cpu",
      "key": "   CPU",
      "keyColor": "cyan"
    },
    {
      "type": "gpu",
      "key": "  󰊴 GPU",
      "keyColor": "cyan"
    },
    {
      "type": "command",
      "key": "  󱦟 OS Age",
      "keyColor": "cyan",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    "break",
    {
      "type": "colors",
      "symbol": "block",
      "block": {
        "range": [
          0,
          15
        ]
      }
    }
  ]
}
